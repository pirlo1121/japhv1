---
/**
 * Seda.astro
 * El lienzo de los hilos de seda (scripts/seda): fijo sobre toda la página,
 * por encima del contenido y por debajo de la cabecera, sin eventos de
 * puntero. Arranca cuando la fuente está lista, para que los contornos del
 * texto coincidan con las letras.
 */
---

<canvas class="seda-lienzo" data-seda-lienzo aria-hidden="true"></canvas>

<script>
  import { iniciarSeda } from '@/scripts/seda/seda';

  document.fonts.ready.then(() => iniciarSeda());
</script>

<style>
  .seda-lienzo {
    position: fixed;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
