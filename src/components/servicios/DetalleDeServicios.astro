---
/**
 * Detalle de los siete servicios: qué es cada uno y qué incluye. Cada
 * servicio es un módulo de la estructura: una placa de grafito con su
 * número inscrito en metal y una arista que se enciende al visitarlo (al
 * pasar el puntero o al llegar desde un enlace #servicio). Todo el
 * contenido está a la vista: nada depende del hover.
 */
import { servicios } from '@/datos/servicios';

const dos = (n: number) => String(n).padStart(2, '0');
---

<section class="detalle" aria-label="Servicios de JAPH">
  <ol class="lista">
    {servicios.map((servicio, i) => (
      <li class="servicio lamina" id={servicio.id}>
        <p class="numero" aria-hidden="true">
          {dos(i + 1)}
        </p>
        <div class="texto">
          <h2>{servicio.nombre}</h2>
          <p>{servicio.descripcion}</p>
        </div>
        <div class="incluye">
          <h3>Incluye</h3>
          <ul>
            {servicio.incluye.map((punto) => (
              <li>{punto}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .lista {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .servicio {
    position: relative;
    display: grid;
    gap: 1.25rem 2.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    scroll-margin-top: 7rem;
    transition:
      border-color 0.35s var(--suave),
      box-shadow 0.35s var(--suave);
  }

  /* La arista del módulo: se enciende al visitarlo. */
  .servicio::before {
    content: '';
    position: absolute;
    inset: -1px auto -1px -1px;
    width: 1px;
    background: linear-gradient(180deg, var(--metal-luz), var(--frio) 60%, transparent);
    box-shadow: 0 0 14px rgb(var(--frio-rgb) / 0.5);
    opacity: 0;
    transition: opacity 0.35s var(--suave);
  }

  .servicio:hover::before,
  .servicio:target::before {
    opacity: 1;
  }

  @media (min-width: 56rem) {
    .servicio {
      grid-template-columns: 4rem 1.2fr 1fr;
      align-items: start;
    }
  }

  .servicio:target {
    border-color: rgb(var(--metal-rgb) / 0.35);
    box-shadow:
      inset 0 1px 0 rgb(var(--metal-rgb) / 0.18),
      0 30px 60px -40px rgb(var(--frio-rgb) / 0.4);
  }

  /* El número, inscrito en metal. */
  .numero {
    margin: 0;
    font-family: var(--fuente-display);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--cromo);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .texto {
    display: grid;
    gap: 0.75rem;
  }

  .texto > *,
  .incluye > * {
    margin: 0;
  }

  h2 {
    font-size: var(--t-3);
  }

  .texto p {
    color: var(--texto-suave);
  }

  .incluye {
    display: grid;
    gap: 0.75rem;
  }

  h3 {
    font-family: var(--fuente-texto);
    font-size: var(--t--2);
    font-weight: 500;
    letter-spacing: var(--rastreo-rotulo);
    text-transform: uppercase;
    color: var(--metadato);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  ul li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: rgb(var(--vacio-rgb) / 0.6);
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.06);
    font-size: var(--t--1);
    color: var(--texto-suave);
  }

  @media (prefers-reduced-motion: reduce) {
    .servicio,
    .servicio::before {
      transition: none;
    }
  }
</style>
