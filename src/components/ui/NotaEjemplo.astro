---
/**
 * Aviso visible de contenido provisional. Nunca debe confundirse con
 * información verificada: se retira cuando el contenido sea real.
 */
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<p class="nota-ejemplo" role="note">
  <strong>{titulo}</strong> <slot />
</p>

<style>
  .nota-ejemplo {
    max-width: 60ch;
    margin: 0;
    padding: 0.85rem 1.1rem;
    border: 1px dashed rgb(var(--metadato-rgb) / 0.45);
    border-radius: 12px;
    background: rgb(var(--fondo-rgb) / 0.55);
    font-size: var(--t--1);
    line-height: 1.55;
    color: var(--texto-suave);
  }

  strong {
    color: var(--metadato);
    font-weight: 600;
  }
</style>
