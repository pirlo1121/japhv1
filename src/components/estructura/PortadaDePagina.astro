---
/**
 * Encabezado de las páginas interiores: el mismo mundo que la portada, en
 * una composición quieta y ligera. Dos monolitos de grafito con sus aristas
 * de luz (CSS) y, delante, la gota de cromo: el póster que pinta el mismo
 * sombreador de la portada (assets/gota-inicial.webp), que flota despacio.
 * Sin WebGL: estas páginas son para leer y actuar, no para recorrer.
 *
 * `ausente` (la 404): falta el monolito principal; en su lugar queda su
 * hueco, un contorno en la oscuridad.
 * El titular admite <em> (texto del equipo, por eso set:html).
 *
 * Slots:
 *   default  la entradilla y lo que vaya bajo el título
 */
import { Picture } from 'astro:assets';
import gotaInicial from '@/assets/gota-inicial.webp';

interface Props {
  id: string;
  rotulo: string;
  titulo: string;
  /** Más alta, para páginas cuyo encabezado es casi todo el contenido (404). */
  completa?: boolean;
  /** Falta el monolito principal: su lugar es un hueco (404). */
  ausente?: boolean;
}

const { id, rotulo, titulo, completa = false, ausente = false } = Astro.props;
---

<section class:list={['portada-pagina', { completa }]} aria-labelledby={id}>
  <div class:list={['escenario', { ausente }]} aria-hidden="true">
    <span class="monolito-css lejano"></span>
    <span class="monolito-css principal">
      <span class="cara"></span>
    </span>
    <span class="losa"></span>
    <span class="gota">
      <Picture
        src={gotaInicial}
        formats={['avif', 'webp']}
        widths={[320, 520, 760]}
        sizes="(max-width: 48rem) 52vw, 22vw"
        alt=""
        loading="eager"
        decoding="async"
      />
    </span>
  </div>
  <div class="contenido">
    <p class="rotulo">{rotulo}</p>
    <h1 id={id} set:html={titulo} />
    <slot />
  </div>
</section>

<style>
  .portada-pagina {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(82svh, 50rem);
    padding: 9rem max(var(--margen), (100% - var(--ancho)) / 2) clamp(3rem, 8vh, 5rem);
    overflow: hidden;
    isolation: isolate;
  }

  .completa {
    min-height: 100svh;
  }

  /* El espacio: aire negro que se funde con la página. */
  .escenario {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--atmosfera), var(--fondo);
  }

  .escenario::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--fondo), transparent 40%),
      linear-gradient(to right, rgb(var(--fondo-rgb) / 0.75), transparent 55%);
    pointer-events: none;
  }

  /* Los monolitos son .monolito-css (base.css); aquí, su sitio y su volumen. */
  .principal {
    right: clamp(4%, 10vw, 14%);
    top: 14%;
    bottom: -10%;
    width: clamp(8rem, 16vw, 15rem);
  }

  /* La cara lateral, en sombra: el volumen del bloque. */
  .principal .cara {
    position: absolute;
    top: 1.6rem;
    bottom: 0;
    left: 100%;
    width: 38%;
    background: linear-gradient(90deg, var(--vacio), rgb(var(--vacio-rgb) / 0.4));
    transform: skewY(-38deg);
    transform-origin: left top;
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.2);
  }

  /* La arista de metal en el borde izquierdo del monolito principal. */
  .principal::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 1px;
    background: linear-gradient(
      180deg,
      rgb(var(--metal-rgb) / 0.85),
      rgb(var(--metal-rgb) / 0.15) 70%
    );
  }

  .lejano {
    right: clamp(30%, 36vw, 42%);
    top: 4%;
    bottom: 18%;
    width: clamp(3rem, 5vw, 5rem);
    opacity: 0.45;
  }

  .losa {
    position: absolute;
    right: 0;
    bottom: 12%;
    width: clamp(14rem, 34vw, 32rem);
    height: 1.1rem;
    background: linear-gradient(180deg, var(--monolito-luz), var(--vacio));
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.3);
    opacity: 0.8;
  }

  /* 404: el monolito principal no está; queda su hueco. */
  .ausente .principal {
    background: transparent;
    box-shadow: none;
    outline: 1px dashed rgb(var(--metal-rgb) / 0.35);
    outline-offset: -1px;
  }

  .ausente .principal .cara,
  .ausente .principal::before {
    display: none;
  }

  /* La gota de cromo, delante del monolito. El póster trae el halo
     del fondo del sombreador (exp(-0.9·r²), r en medios altos del render);
     detrás se pinta el mismo halo, más grande, para que su borde fundido no
     se note: la caja del póster mide 0.872 medios altos de radio. */
  .gota {
    position: absolute;
    right: calc(clamp(4%, 10vw, 14%) + clamp(8rem, 16vw, 15rem) * 0.55);
    top: 30%;
    width: clamp(11rem, 22vw, 20rem);
    aspect-ratio: 1;
    translate: 50% 0;
  }

  .gota::before {
    content: '';
    position: absolute;
    inset: -75%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgb(var(--halo-escena-rgb) / 1) 0,
      rgb(var(--halo-escena-rgb) / 0.84) 20%,
      rgb(var(--halo-escena-rgb) / 0.5) 40%,
      rgb(var(--halo-escena-rgb) / 0.21) 60%,
      rgb(var(--halo-escena-rgb) / 0.065) 80%,
      transparent
    );
  }

  .gota :global(img) {
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    mask-image: radial-gradient(closest-side, rgb(0 0 0) 74%, transparent);
  }

  :global(.movimiento) .gota {
    animation: flotar 9s ease-in-out infinite alternate;
  }

  @keyframes flotar {
    to {
      translate: 50% -1.2rem;
    }
  }

  .contenido {
    position: relative;
    display: grid;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .contenido > :global(*) {
    margin: 0;
  }

  h1 {
    font-size: var(--t-6);
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-shadow: 0 2px 30px rgb(var(--fondo-rgb) / 0.6);
  }

  .contenido :global(p:not(.rotulo)) {
    max-width: 52ch;
    font-size: var(--t-1);
    color: var(--texto-suave);
  }

  /* Pantallas estrechas: la composición arriba, el texto debajo. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .portada-pagina {
      padding-top: 52svh;
    }

    .principal {
      right: 14%;
      top: 9rem;
      bottom: auto;
      height: 38svh;
      width: 7rem;
    }

    .lejano {
      right: auto;
      left: 10%;
      top: 7rem;
      bottom: auto;
      height: 30svh;
    }

    .gota {
      right: calc(14% + 4rem);
      top: 14rem;
      width: min(52vw, 15rem);
    }

    .escenario::after {
      background: linear-gradient(to top, var(--fondo), var(--fondo) 38%, transparent 62%);
    }
  }
</style>
