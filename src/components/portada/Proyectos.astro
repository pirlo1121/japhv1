---
/**
 * Escena 07 · Proyectos. La arquitectura se vuelve una galería: tres
 * nichos en un muro oscuro, y aquí cada proyecto es una pieza enmarcada en
 * su hueco. La red se ordena y la escena se calla para que hablen los
 * proyectos. Cada uno dice qué se creó, qué problema resolvía, qué hizo
 * JAPH y, solo si está verificado, qué resultado tuvo.
 *
 * Los casos vienen de datos/proyectos.ts. Mientras sean ejemplos se marcan
 * como tales: nunca se presentan como trabajo real.
 */
import { Image } from 'astro:assets';
import NotaEjemplo from '@/components/ui/NotaEjemplo.astro';
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import { destacados } from '@/datos/proyectos';

const hayEjemplos = destacados.some((proyecto) => proyecto.ejemplo);
const dos = (n: number) => String(n).padStart(2, '0');
---

<section
  class="proyectos"
  id="proyectos-destacados"
  aria-labelledby="titulo-destacados"
  data-escena="Proyectos"
>
  <header class="cabecera" data-revelar data-zona-lectura>
    <p class="rotulo">07 · Proyectos</p>
    <h2 id="titulo-destacados">
      Proyectos que <em>cobran vida.</em>
    </h2>
    {hayEjemplos && (
      <NotaEjemplo titulo="Contenido de ejemplo.">
        Los tres casos de esta sección son marcadores de posición. Sustituye nombres, textos e
        imágenes por proyectos reales de JAPH (src/datos/proyectos.ts) antes de publicar el sitio.
      </NotaEjemplo>
    )}
  </header>

  <ol class="lista">
    {destacados.map((proyecto, i) => (
      <li class="proyecto">
        <article aria-labelledby={`proyecto-${i}`}>
          <div class="visual" data-reflejo>
            {proyecto.imagen ? (
              <Image
                class="medio"
                src={proyecto.imagen}
                alt={proyecto.alt ?? ''}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 26rem, (min-width: 40rem) 50vw, 100vw"
              />
            ) : (
              <div class:list={['medio', 'pintura', `tono-${proyecto.tono}`]} aria-hidden="true" />
            )}
            <span class="ordinal" aria-hidden="true">
              {dos(i + 1)}
            </span>
          </div>
          <div class="texto">
            <h3 id={`proyecto-${i}`}>{proyecto.titulo}</h3>
            <p class="descripcion">{proyecto.descripcion}</p>
            <dl>
              <div>
                <dt>Problema</dt>
                <dd>{proyecto.problema}</dd>
              </div>
              <div>
                <dt>Rol de JAPH</dt>
                <dd>{proyecto.rol}</dd>
              </div>
              {proyecto.resultado && (
                <div>
                  <dt>Resultado</dt>
                  <dd>{proyecto.resultado}</dd>
                </div>
              )}
            </dl>
            <p class="pie">
              {proyecto.enlace && (
                <a href={proyecto.enlace}>
                  Ver proyecto <span class="solo-lectores">{proyecto.titulo}</span>
                  <span aria-hidden="true">→</span>
                </a>
              )}
              {proyecto.ejemplo && <SelloEjemplo>Caso de ejemplo</SelloEjemplo>}
            </p>
          </div>
        </article>
      </li>
    ))}
  </ol>

  <p class="mas" data-revelar>
    <a class="boton" href="/proyectos">
      Ver todos los proyectos
    </a>
  </p>
</section>

<style>
  .cabecera {
    max-width: 40rem;
  }

  .lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    position: relative;
    display: grid;
    /* Una columna que nunca crece con su contenido: la imagen no ensancha la tarjeta. */
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgb(var(--monolito-rgb) / 0.95),
      rgb(var(--vacio-rgb) / 0.92)
    );
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.1);
    transition:
      border-color 0.35s var(--suave),
      box-shadow 0.35s var(--suave);
  }

  /* Al pasar o enfocar: la arista superior recoge luz. */
  article::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 1px;
    background: var(--arista);
    opacity: 0;
    transition: opacity 0.35s var(--suave);
  }

  article:hover,
  article:focus-within {
    border-color: rgb(var(--metal-rgb) / 0.32);
    box-shadow:
      inset 0 1px 0 rgb(var(--metal-rgb) / 0.18),
      0 24px 50px -30px rgb(var(--azul-rgb) / 0.6);
  }

  article:hover::before,
  article:focus-within::before {
    opacity: 1;
  }

  /* El nicho: la imagen dentro de un hueco rehundido en el muro. */
  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0.6rem 0.6rem 0;
    overflow: hidden;
    border-radius: 1px;
  }

  .visual::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 0 0 1px rgb(var(--metal-rgb) / 0.12),
      inset 0 22px 30px -22px rgb(var(--vacio-rgb) / 0.95);
    pointer-events: none;
  }

  .medio {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      scale 0.6s var(--suave),
      filter 0.6s var(--suave);
    filter: brightness(0.88);
  }

  article:hover .medio,
  article:focus-within .medio {
    scale: 1.03;
    filter: brightness(1);
  }

  .visual .ordinal {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
  }

  .texto {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .texto > * {
    margin: 0;
  }

  h3 {
    font-size: var(--t-2);
  }

  dl {
    gap: 0.6rem;
    margin: 0.25rem 0 0;
    font-size: var(--t--1);
  }

  dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metadato);
  }

  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .pie a {
    color: var(--texto);
    text-decoration: none;
  }

  .pie a span[aria-hidden] {
    color: var(--cian);
  }

  .mas {
    margin: 2.5rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    article,
    article::before,
    .medio {
      transition: none;
    }
  }
</style>
