---
/**
 * Capítulo 02 · Transformación. Una intención adquiere forma: el monolito
 * se abre en un pórtico y la gota se estira en una curva de cromo que
 * atraviesa la abertura (principio: la gota; desarrollo: se estira
 * mientras el monolito se abre; final: la curva cruza el pórtico). La
 * rigidez del pórtico es la referencia contra la que el líquido se vuelve
 * expresivo.
 *
 * Los tres estados de la materia (líquido, forma, sólido) cuentan lo mismo
 * que la escena (de la idea al producto) en una placa de tres celdas. Con
 * movimiento se encienden con el progreso del capítulo (--p), al ritmo de
 * la gota; nunca se ocultan. El manifiesto es un bloque editorial que se
 * lee entero desde que aparece.
 */
const estados = [
  { estado: 'Líquido', que: 'la idea', forma: 'liquido' },
  { estado: 'Forma', que: 'el diseño', forma: 'forma' },
  { estado: 'Sólido', que: 'el producto', forma: 'solido' }
];

const clausulas = [
  'Una presencia digital sana funciona como un ecosistema:',
  'el sitio atrae,',
  'la automatización responde,',
  'el producto retiene,',
  'el contenido sostiene',
  'y la marca le da sentido a todo lo demás.'
];
---

<section
  class="transformacion"
  id="transformacion"
  aria-labelledby="titulo-transformacion"
  data-escena="Transformación"
>
  <div class="marco">
    <div class="bloque" data-zona-lectura>
      <p class="rotulo">02 · La transformación</p>
      <h2 id="titulo-transformacion">
        Las ideas <em>toman forma.</em>
      </h2>
      <p class="entrada">
        Convertimos conceptos en experiencias digitales diseñadas para funcionar, conectar y crecer.
      </p>
      <ol class="estados lamina" aria-label="De la idea al producto">
        {estados.map(({ estado, que, forma }, i) => (
          <li data-paso style={{ '--u': 0.08 + i * 0.18 }}>
            <span class:list={['glifo', forma]} aria-hidden="true" />
            <span class="estado">{estado}</span>
            <span class="que">{que}</span>
          </li>
        ))}
      </ol>
      <p class="manifiesto">{clausulas.join(' ')}</p>
    </div>
  </div>
</section>

<style>
  /* Nunca más ancho que la mitad de la pantalla: la otra mitad es del pórtico. */
  .bloque {
    display: grid;
    gap: 1.6rem;
    max-width: min(36rem, 52vw);
  }

  .bloque > * {
    margin: 0;
  }

  .entrada {
    font-size: var(--t-1);
  }

  /* Tres celdas separadas por aristas: de la gota al bloque. */
  .estados {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .estados li {
    display: grid;
    gap: 0.25rem;
    padding: 1.15rem 1.1rem 1.2rem;
  }

  .estados li + li {
    border-left: 1px solid var(--linea);
  }

  /* El glifo de cada estado: la misma materia, cada vez más rígida. */
  .glifo {
    width: 1.1rem;
    aspect-ratio: 1;
    margin-bottom: 0.65rem;
    background: var(--gota);
  }

  .liquido {
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  }

  .forma {
    border-radius: 30%;
    background: linear-gradient(140deg, var(--metal-luz), var(--metal-sombra));
  }

  .solido {
    border-radius: 1px;
    background: linear-gradient(140deg, var(--metal), var(--grafito) 70%);
    box-shadow:
      inset 0 1px 0 rgb(var(--metal-rgb) / 0.6),
      0 0 0 1px rgb(var(--metal-rgb) / 0.2);
  }

  .estado {
    color: var(--texto);
    font-weight: 500;
  }

  .que {
    font-size: var(--t--1);
    color: var(--metadato);
  }

  /* El manifiesto: un bloque editorial con una arista de luz a su izquierda. */
  .manifiesto {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--t-2);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--texto);
  }

  .manifiesto::before {
    content: '';
    position: absolute;
    inset: 0.35em auto 0.35em 0;
    width: 1px;
    background: linear-gradient(180deg, var(--metal), rgb(var(--metal-rgb) / 0.3), transparent);
  }

  /* Móvil o vertical: la escultura arriba, el texto debajo con espacio para verla. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .marco {
      padding-top: 38svh;
    }

    /* Aquí el pórtico va encima, no al lado: todo el ancho. */
    .bloque {
      max-width: 36rem;
    }

    .estados li {
      padding: 1rem 0.8rem;
    }
  }
</style>
