---
/**
 * Enlace o botón de acción. Con `href` es un <a>; sin él, un <button>.
 * La acción principal (sólido) lleva una flecha verde: el acento más escaso
 * del sistema señala el siguiente paso.
 */
interface Props {
  href?: string;
  tipo?: 'button' | 'submit';
  variante?: 'contorno' | 'solido';
  /** Los hilos de seda lo tejen al entrar en pantalla (`inicio`: al cargar la página). */
  seda?: boolean | 'inicio';
}

const { href, tipo = 'button', variante = 'contorno', seda = false } = Astro.props;
const atributosSeda = seda
  ? { 'data-seda': 'caja', ...(seda === 'inicio' ? { 'data-seda-inicio': '' } : {}) }
  : {};
const clases = ['boton', `boton--${variante}`];
---

{href ? (
  <a class:list={clases} href={href} {...atributosSeda}>
    <slot />
    {variante === 'solido' && (
      <span class="flecha" aria-hidden="true">
        →
      </span>
    )}
  </a>
) : (
  <button class:list={clases} type={tipo} {...atributosSeda}>
    <slot />
    {variante === 'solido' && (
      <span class="flecha" aria-hidden="true">
        →
      </span>
    )}
  </button>
)}
