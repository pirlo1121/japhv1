---
/**
 * Enlace o botón de acción. Con `href` es un <a>; sin él, un <button>.
 * La acción principal (sólido) es una placa de metal claro con una flecha:
 * el siguiente paso, sin neón.
 */
interface Props {
  href?: string;
  tipo?: 'button' | 'submit';
  variante?: 'contorno' | 'solido';
}

const { href, tipo = 'button', variante = 'contorno' } = Astro.props;
const clases = ['boton', `boton--${variante}`];
---

{href ? (
  <a class:list={clases} href={href}>
    <slot />
    {variante === 'solido' && (
      <span class="flecha" aria-hidden="true">
        →
      </span>
    )}
  </a>
) : (
  <button class:list={clases} type={tipo}>
    <slot />
    {variante === 'solido' && (
      <span class="flecha" aria-hidden="true">
        →
      </span>
    )}
  </button>
)}
