---
/**
 * Tres formas de trabajar juntos (precios de ejemplo en datos/planes.ts:
 * se muestran marcados como tales). Tres placas de grafito; la
 * recomendada recoge una arista de luz en su canto superior.
 */
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import type { Plan } from '@/datos/planes';

interface Props {
  planes: Plan[];
}

const { planes } = Astro.props;
---

<ul class="planes">
  {planes.map((plan) => (
    <li class:list={['plan', 'lamina', { destacado: plan.destacado }]}>
      <article>
        {plan.destacado && <p class="marca">Recomendado</p>}
        <h3>{plan.nombre}</h3>
        <p class="precio">
          {plan.precio}
          {plan.ejemplo && <SelloEjemplo>Precio de ejemplo</SelloEjemplo>}
        </p>
        <p class="resumen">{plan.resumen}</p>
        <ul class="incluye">
          {plan.incluye.map((punto) => (
            <li>{punto}</li>
          ))}
        </ul>
      </article>
    </li>
  ))}
</ul>

<style>
  .planes {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .planes {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }

  .plan {
    position: relative;
  }

  .plan article {
    display: grid;
    gap: 1rem;
    align-content: start;
    height: 100%;
    padding: 2rem 1.75rem;
  }

  .plan article > * {
    margin: 0;
  }

  .destacado {
    border-color: rgb(var(--metal-rgb) / 0.32);
    box-shadow:
      inset 0 1px 0 rgb(var(--metal-rgb) / 0.2),
      0 40px 80px -50px rgb(var(--cian-rgb) / 0.45);
  }

  .destacado::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 1px;
    background: var(--arista);
  }

  .marca {
    justify-self: start;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radio);
    background: linear-gradient(180deg, var(--metal-luz), var(--metal));
    color: var(--vacio);
    font-size: var(--t--2);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  h3 {
    font-size: var(--t-3);
  }

  .precio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--fuente-display);
    font-size: var(--t-2);
    color: var(--texto);
  }

  .resumen {
    color: var(--texto-suave);
  }

  .incluye {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--linea);
    list-style: none;
  }

  .incluye li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t--1);
    color: var(--texto-suave);
  }

  /* Viñeta: un bloque mínimo de metal. */
  .incluye li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.55em;
    width: 0.4rem;
    aspect-ratio: 1;
    border-radius: 1px;
    background: linear-gradient(140deg, var(--metal-luz), var(--metal-sombra));
  }
</style>
