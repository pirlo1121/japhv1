---
/**
 * Capítulo 01 · Presencia. Presenta JAPH y su propuesta de valor con un
 * solo gesto visual: un monolito enorme emerge de la penumbra y, delante,
 * flota una gota de cromo (la intención). La gota está a la derecha del
 * titular (en móvil, encima); el monolito, detrás (scripts/lienzo).
 *
 * El titular, la entrada y la llamada a la acción se ven desde la primera
 * pintura: la animación de entrada es corta y nunca los oculta (sin
 * JavaScript o con "reducir movimiento" no hay animación). Una arista por
 * la que baja una luz invita a deslizar.
 */
import Boton from '@/components/ui/Boton.astro';
---

<section class="presencia" id="inicio" aria-labelledby="titulo-presencia" data-escena="Inicio">
  <div class="contenido" data-zona-lectura>
    <p class="rotulo">Estrategia / Diseño / Tecnología</p>
    <h1 id="titulo-presencia">
      Convertimos ideas en <em>ecosistemas digitales.</em>
    </h1>
    <p class="entrada">
      Diseñamos, construimos y conectamos productos digitales que transforman ideas en soluciones
      reales.
    </p>
    <p class="acciones">
      <Boton href="/contacto" variante="solido">
        Empezar un proyecto
      </Boton>
      <Boton href="#servicios">Ver servicios</Boton>
    </p>
  </div>

  <p class="descenso" aria-hidden="true">
    <span class="arista"></span>
    <span class="texto">Desliza</span>
  </p>
</section>

<style>
  .presencia {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding-top: 8rem;
    padding-bottom: 7rem;
  }

  /* El texto no pisa la gota: su borde derecho no pasa del 46 % del ancho.
     Detrás de un texto la escena baja sus brillos. */
  .contenido {
    display: grid;
    gap: 1.6rem;
    max-width: min(40rem, 46vw);
  }

  .contenido > * {
    margin: 0;
  }

  h1 {
    font-size: var(--t-5);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 11ch;
  }

  .entrada {
    max-width: 40ch;
    font-size: var(--t-1);
    color: var(--texto-suave);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  /* Invitación a bajar: una arista vertical por la que desciende una luz. */
  .descenso {
    position: absolute;
    right: max(var(--margen), (100% - var(--ancho)) / 2);
    bottom: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin: 0;
  }

  .descenso .texto {
    font-size: var(--t--2);
    letter-spacing: var(--rastreo-rotulo);
    text-transform: uppercase;
    color: var(--metadato);
    writing-mode: vertical-rl;
  }

  .arista {
    position: relative;
    width: 1px;
    height: 4.5rem;
    overflow: hidden;
    background: var(--linea-fuerte);
  }

  .arista::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--metal-luz), transparent);
    translate: 0 -100%;
  }

  /* Entrada desde la sombra: corta y escalonada; el titular ya ocupa su sitio. */
  :global(.movimiento) .contenido > * {
    animation: emerger 0.8s var(--suave) both;
  }

  :global(.movimiento) h1 {
    animation-delay: 0.08s;
  }

  :global(.movimiento) .entrada {
    animation-delay: 0.2s;
  }

  :global(.movimiento) .acciones {
    animation-delay: 0.3s;
  }

  :global(.movimiento) .descenso {
    animation: emerger 0.8s var(--suave) 0.6s both;
  }

  :global(.movimiento) .arista::after {
    animation: descender 2.6s cubic-bezier(0.6, 0, 0.4, 1) 1.2s infinite;
  }

  @keyframes emerger {
    from {
      opacity: 0;
      translate: 0 0.8rem;
    }
  }

  @keyframes descender {
    to {
      translate: 0 260%;
    }
  }

  /* Apaisado y bajo (móvil en horizontal): el titular se mide por el alto y
     es más ancho, con menos aire, para que titular, entrada y acciones
     quepan en la primera pantalla. */
  @media (max-height: 34rem) {
    .presencia {
      padding-top: 4.75rem;
      padding-bottom: 1.25rem;
    }

    .contenido {
      gap: 0.8rem;
    }

    h1 {
      font-size: min(var(--t-5), 11svh);
      max-width: 14ch;
    }

    .descenso {
      display: none;
    }
  }

  /* Móvil o vertical: la gota y el monolito arriba, el texto debajo, todo en
     la primera pantalla. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .presencia {
      align-content: end;
      padding-top: 42svh;
      padding-bottom: 2.75rem;
    }

    .contenido {
      gap: 1.1rem;
      max-width: 40rem;
    }

    .descenso {
      display: none;
    }
  }

  /* Móvil bajo (320 × 640): un poco menos de escena para que la acción
     principal quepa en la primera pantalla. */
  @media (max-width: 47.99rem) and (max-height: 44rem) {
    .presencia {
      padding-top: 36svh;
    }
  }
</style>
