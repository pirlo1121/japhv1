---
/**
 * Portada: Monumental Architecture + Editorial Storytelling. Una intención
 * adquiere forma, esa forma encuentra estructura y la estructura revela un
 * sistema de capacidades y resultados. Seis capítulos, un protagonista
 * visual por capítulo: la arquitectura de monolitos manda; la gota de
 * cromo (la intención) es secundaria y solo aparece donde cuenta algo.
 * El orden de este archivo es el orden de la historia; cada capítulo es una
 * <section> con id propio, y scripts/historia/escenarios.ts dice dónde
 * están la cámara y la arquitectura en cada uno (scripts/lienzo/arquitectura.ts).
 *
 *   01 Presencia       Presencia       el monolito y la gota; titular y acción
 *   02 Transformación  Transformacion  el monolito se abre; la gota, estirada, lo atraviesa
 *   03 Capacidades     Capacidades     siete módulos; se enciende el del servicio activo
 *   04 Método          Metodo          cuatro puertas; se enciende la de la fase actual
 *   05 Evidencia       Evidencia       una galería de nichos; hablan los proyectos
 *   06 Apertura        Apertura        el pórtico del principio, en calma; la invitación
 */
import Apertura from '@/components/portada/Apertura.astro';
import Capacidades from '@/components/portada/Capacidades.astro';
import Evidencia from '@/components/portada/Evidencia.astro';
import Lienzo from '@/components/portada/Lienzo.astro';
import Metodo from '@/components/portada/Metodo.astro';
import Presencia from '@/components/portada/Presencia.astro';
import Recorrido from '@/components/portada/Recorrido.astro';
import Transformacion from '@/components/portada/Transformacion.astro';
import Base from '@/layouts/Base.astro';
import { sitio } from '@/config/sitio';

const capitulos = [
  { id: 'inicio', nombre: 'Inicio' },
  { id: 'transformacion', nombre: 'Transformación' },
  { id: 'servicios', nombre: 'Servicios' },
  { id: 'proceso', nombre: 'Método' },
  { id: 'proyectos-destacados', nombre: 'Proyectos' },
  { id: 'llamada', nombre: 'Contacto' }
];
---

<Base titulo={`${sitio.nombre} · ${sitio.lema}`} descripcion={sitio.descripcion} inmersiva>
  <Lienzo />
  <Presencia />
  <Recorrido escenas={capitulos} />
  <Transformacion />
  <Capacidades />
  <Metodo />
  <Evidencia />
  <Apertura />
</Base>

<script>
  import { iniciarHistoria } from '@/scripts/historia/iniciar';
  import { iniciarLienzo } from '@/scripts/lienzo/escena';
  import { crearEstadoNarrativo } from '@/scripts/lienzo/narrativa';

  const estado = crearEstadoNarrativo();
  iniciarHistoria(estado);
  // Solo en desarrollo: inspeccionar y ajustar la escena desde la consola.
  if (import.meta.env.DEV) Object.assign(window, { __estado: estado });

  // La escultura compila su shader después de la primera pintura del texto.
  const arrancar = () => {
    const escena = iniciarLienzo(estado);
    if (import.meta.env.DEV) Object.assign(window, { __escena: escena });
  };
  if ('requestIdleCallback' in window) requestIdleCallback(arrancar, { timeout: 600 });
  else setTimeout(arrancar, 200);
</script>
