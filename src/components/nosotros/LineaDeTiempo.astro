---
/** Historia del estudio (datos/nosotros.ts → hitos), como una línea con estrellas. */
import { hitos } from '@/datos/nosotros';
---

<ol class="linea">
  {hitos.map(({ cuando, titulo, descripcion }) => (
    <li class="hito">
      <span class="estrella" aria-hidden="true" />
      <p class="cuando">{cuando}</p>
      <h3>{titulo}</h3>
      <p>{descripcion}</p>
    </li>
  ))}
</ol>

<style>
  .linea {
    position: relative;
    display: grid;
    gap: 2.75rem;
    margin: 0;
    padding: 0 0 0 2.5rem;
    list-style: none;
  }

  .linea::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 0.55rem;
    width: 1px;
    background: linear-gradient(var(--metal), rgb(var(--cian-rgb) / 0.45) 50%, transparent);
  }

  .hito {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }

  .hito > * {
    margin: 0;
  }

  /* Cada hito, un monolito en miniatura sobre la arista del tiempo. */
  .estrella {
    position: absolute;
    top: 0.15rem;
    left: calc(-2.5rem + 0.3rem);
    width: 0.55rem;
    height: 1.1rem;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--monolito-luz), var(--monolito));
    box-shadow:
      inset 1px 0 0 rgb(var(--cian-rgb) / 0.75),
      inset 0 1px 0 rgb(var(--metal-rgb) / 0.5),
      0 0 0 1px rgb(var(--metal-rgb) / 0.25),
      0 0 14px rgb(var(--cian-rgb) / 0.25);
  }

  .cuando {
    font-size: var(--t--2);
    letter-spacing: var(--rastreo-rotulo);
    text-transform: uppercase;
    color: var(--metadato);
  }

  h3 {
    font-size: var(--t-2);
  }

  .hito p:last-child {
    max-width: 52ch;
    color: var(--texto-suave);
  }
</style>
