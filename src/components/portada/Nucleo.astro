---
/**
 * Escena 04 · El núcleo. De cerca, con el scroll se encienden circuitos de
 * luz cian y violeta dentro del cuerpo del guía: lo que hace que funcione.
 * Habla de profundidad técnica sin convertirse en un diagrama: el texto
 * son los principios de trabajo reales de JAPH (datos/nosotros.ts).
 */
import { principios } from '@/datos/nosotros';

/** En la portada basta la primera frase de cada principio. */
const primeraFrase = (texto: string) => texto.split(/(?<=\.)\s/)[0] ?? texto;
---

<section class="nucleo" id="nucleo" aria-labelledby="titulo-nucleo" data-escena="Núcleo">
  <div class="marco">
    <div class="bloque" data-zona-lectura>
      <p class="rotulo">04 · El núcleo</p>
      <h2 id="titulo-nucleo" data-gota>
        Detrás de cada experiencia, <em>hay un sistema.</em>
      </h2>
      <p class="entrada">
        Diseñamos arquitecturas sólidas para que cada componente tenga sentido y todo funcione en
        conjunto.
      </p>
      <ul class="principios" aria-label="Principios de trabajo" data-pasos data-guia data-liquido>
        {principios.map(({ titulo, descripcion }, i) => (
          <li data-paso style={{ '--u': 0.15 + i * 0.17 }}>
            <span class="ordinal" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{titulo}</h3>
            <p>{primeraFrase(descripcion)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .bloque {
    display: grid;
    gap: 1.4rem;
    max-width: 38rem;
  }

  .bloque > * {
    margin: 0;
  }

  .entrada {
    font-size: var(--t-1);
  }

  .principios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--linea);
  }

  .principios li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.1rem 1.2rem 1.2rem;
    background: rgb(var(--superficie-rgb) / 0.82);
  }

  h3 {
    font-size: var(--t-0);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .principios p {
    margin: 0;
    font-size: var(--t--1);
  }

  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .marco {
      padding-top: 40svh;
    }
  }
</style>
