---
/**
 * Índice de la portada: una regla vertical en el borde derecho, como la
 * escala de un plano de arquitectura: una marca por capítulo
 * ([data-escena]). Son enlaces normales a cada sección, así que funcionan
 * sin JavaScript; el script solo marca el capítulo actual (su marca se
 * alarga y recoge luz). Al saltar a uno, la historia sincroniza la cámara
 * con el scroll. En pantallas estrechas no aparece: allí basta el scroll.
 */
interface Props {
  escenas: { id: string; nombre: string }[];
}

const { escenas } = Astro.props;
---

<nav class="recorrido" aria-label="Capítulos de la portada" data-recorrido>
  <ol>
    {escenas.map(({ id, nombre }, i) => (
      <li>
        <a href={`#${id}`} data-destino={id}>
          <span class="nombre">
            {nombre}
            <span class="solo-lectores">
              , capítulo {i + 1} de {escenas.length}
            </span>
          </span>
          <span class="nodo" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-recorrido] a')];
  const porId = new Map(enlaces.map((a) => [a.dataset.destino, a]));
  const marcar = (id: string) => {
    for (const [destino, enlace] of porId) {
      if (destino === id) enlace.setAttribute('aria-current', 'location');
      else enlace.removeAttribute('aria-current');
    }
  };
  // Cuenta como actual la escena que cruza la línea media de la pantalla.
  const vigia = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) if (entrada.isIntersecting) marcar(entrada.target.id);
    },
    { rootMargin: '-50% 0px -50% 0px' }
  );
  for (const id of porId.keys()) {
    const seccion = id ? document.getElementById(id) : null;
    if (seccion) vigia.observe(seccion);
  }
</script>

<style>
  .recorrido {
    display: none;
  }

  @media (min-width: 64rem) and (min-height: 40rem) {
    .recorrido {
      position: fixed;
      top: 50%;
      right: clamp(0.75rem, 1.6vw, 1.75rem);
      z-index: 6;
      display: block;
      translate: 0 -50%;
    }
  }

  ol {
    position: relative;
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* El filamento que une los nodos. */
  ol::after {
    content: '';
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    right: calc(0.75rem / 2 - 0.5px);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(var(--metal-rgb) / 0.22) 15%,
      rgb(var(--metal-rgb) / 0.22) 85%,
      transparent
    );
    pointer-events: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 2rem;
    text-decoration: none;
  }

  /* La marca: una línea corta que crece hacia la izquierda desde la regla. */
  .nodo {
    position: relative;
    z-index: 1;
    width: 1.5rem;
    height: 0.75rem;
    display: grid;
    place-items: center end;
  }

  .nodo::before {
    content: '';
    width: 0.6rem;
    height: 1px;
    background: var(--texto-apagado);
    transition:
      width 0.5s var(--suave),
      background-color 0.5s var(--suave),
      box-shadow 0.5s var(--suave);
  }

  .nombre {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: rgb(var(--monolito-rgb) / 0.92);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--texto-suave);
    white-space: nowrap;
    opacity: 0;
    translate: 0.4rem 0;
    transition:
      opacity var(--rapido),
      translate var(--rapido);
  }

  a:hover .nombre,
  a:focus-visible .nombre {
    opacity: 1;
    translate: 0 0;
  }

  a:hover .nodo::before,
  a:focus-visible .nodo::before {
    width: 1rem;
    background: var(--metal);
  }

  a[aria-current='location'] .nodo::before {
    width: 1.5rem;
    background: linear-gradient(90deg, var(--azul), var(--metal-luz));
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible .nodo {
    outline: 2px solid var(--azul);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nodo::before,
    .nombre {
      transition: none;
    }
  }
</style>
