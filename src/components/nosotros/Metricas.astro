---
/** Métricas del estudio (datos/cifras.ts → cifrasEstudio). */
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import { cifrasEstudio } from '@/datos/cifras';
---

<dl class="metricas">
  {cifrasEstudio.map((cifra) => (
    <div class="metrica">
      <dt>
        {cifra.valor}
        {cifra.sufijo}
      </dt>
      <dd>
        {cifra.descripcion} {cifra.ejemplo && <SelloEjemplo>Ejemplo</SelloEjemplo>}
      </dd>
    </div>
  ))}
</dl>

<style>
  .metricas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--linea);
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.12);
  }

  .metrica {
    display: grid;
    gap: 0.6rem;
    padding: 1.75rem 1.5rem;
    background: linear-gradient(
      180deg,
      rgb(var(--monolito-rgb) / 0.95),
      rgb(var(--vacio-rgb) / 0.92)
    );
  }

  /* La cifra, inscrita en metal. */
  dt {
    font-family: var(--fuente-display);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--cromo);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  dd {
    margin: 0;
    font-size: var(--t--1);
    color: var(--texto-suave);
  }
</style>
