---
/**
 * Legal.astro
 * Estructura de las páginas legales: encabezado de la casa (sin escena
 * WebGL: aquí manda la lectura), índice numerado sobre una arista (fijo en
 * escritorio; en móvil, un bloque compacto antes del texto; las etiquetas
 * ya traen su número), aviso de
 * plantilla y cuerpo de lectura larga, a ritmo del lector.
 *
 * Slots:
 *   aviso    el aviso de "plantilla, revisar con un abogado"
 *   default  las secciones del documento (<section id="…">)
 */
import PortadaDePagina from '@/components/estructura/PortadaDePagina.astro';
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import Base from './Base.astro';

export interface EntradaDeIndice {
  id: string;
  etiqueta: string;
}

interface Props {
  titulo: string;
  descripcion: string;
  encabezado: string;
  actualizacion: string;
  fechaDeEjemplo?: boolean;
  indice: EntradaDeIndice[];
}

const {
  titulo,
  descripcion,
  encabezado,
  actualizacion,
  fechaDeEjemplo = false,
  indice
} = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion}>
  <PortadaDePagina id="titulo-legal" rotulo="Legal" titulo={encabezado}>
    <p>
      Última actualización: {actualizacion}
      {fechaDeEjemplo && <SelloEjemplo>Fecha de ejemplo</SelloEjemplo>}
    </p>
  </PortadaDePagina>

  <article class="documento" aria-labelledby="titulo-legal">
    <nav class="indice" aria-label="Índice del documento">
      <p class="titulo-indice" aria-hidden="true">
        Índice
      </p>
      <ol>
        {indice.map(({ id, etiqueta }) => (
          <li>
            <a href={`#${id}`}>{etiqueta}</a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="cuerpo">
      <aside class="aviso" role="note">
        <slot name="aviso" />
      </aside>
      <slot />
    </div>
  </article>
</Base>

<style>
  .documento {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 62rem) {
    .documento {
      grid-template-columns: 16rem 1fr;
      gap: 4.5rem;
      align-items: start;
    }

    .indice {
      position: sticky;
      top: 7rem;
    }
  }

  /* En móvil: un bloque compacto de grafito, en dos columnas. */
  .indice {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: rgb(var(--monolito-rgb) / 0.7);
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.1);
  }

  .titulo-indice {
    margin: 0 0 0.85rem;
    font-size: var(--t--2);
    letter-spacing: var(--rastreo-rotulo);
    text-transform: uppercase;
    color: var(--metadato);
  }

  .indice ol {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 0.55rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .indice a {
    font-size: var(--t--1);
    color: var(--texto-suave);
    text-decoration: none;
    transition: color var(--rapido);
  }

  .indice a:hover {
    color: var(--texto);
  }

  /* Táctil: cada entrada del índice es un objetivo de al menos 44 px de alto. */
  @media (pointer: coarse) {
    .indice ol {
      row-gap: 0;
    }

    .indice a {
      display: flex;
      align-items: center;
      min-height: var(--toque);
    }
  }

  /* En escritorio: una columna lateral sobre una arista vertical. */
  @media (min-width: 62rem) {
    .indice {
      padding: 0 0 0 1.25rem;
      border: 0;
      border-left: 1px solid var(--linea-fuerte);
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .indice ol {
      grid-template-columns: 1fr;
    }
  }

  .cuerpo {
    max-width: 68ch;
  }

  .aviso {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px dashed rgb(var(--metadato-rgb) / 0.5);
    border-radius: var(--radio);
    background: rgb(var(--monolito-rgb) / 0.75);
    font-size: var(--t--1);
    line-height: 1.6;
    color: var(--texto-suave);
  }

  .aviso :global(strong) {
    color: var(--texto);
  }

  .cuerpo :global(section) {
    padding-block: 2rem;
    border-top: 1px solid var(--linea);
    scroll-margin-top: 6rem;
  }

  .cuerpo :global(section:first-of-type) {
    border-top: 0;
    padding-top: 0;
  }

  .cuerpo :global(h2) {
    margin-bottom: 1rem;
    font-size: var(--t-2);
  }

  .cuerpo :global(section p),
  .cuerpo :global(section li) {
    line-height: 1.75;
    color: var(--texto-suave);
  }

  .cuerpo :global(section a) {
    color: var(--texto);
    text-decoration-color: rgb(var(--metal-rgb) / 0.5);
    text-underline-offset: 0.2em;
  }

  .cuerpo :global(strong) {
    color: var(--texto);
  }
</style>
