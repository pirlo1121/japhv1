---
/**
 * Escena 01 · El vacío. Un monolito enorme emerge de la oscuridad de un
 * vacío azul medianoche; delante flota una gota de cromo líquido, a la
 * derecha del titular (en móvil, encima). Es el plano general: misterio.
 * Al bajar, la cámara se acerca, el monolito se abre y la gota se estira en
 * una cinta (scripts/lienzo, scripts/historia).
 *
 * El texto entra con sobriedad, de abajo arriba como si saliera de la
 * sombra (solo con movimiento; el titular se ve desde la primera pintura).
 * Una línea de luz que baja por una arista invita a deslizar.
 */
---

<section class="vacio" id="inicio" aria-labelledby="titulo-vacio" data-escena="Inicio">
  <div class="contenido" data-zona-lectura>
    <p class="rotulo">Estrategia / Diseño / Tecnología</p>
    <h1 id="titulo-vacio">
      Convertimos ideas en <em>ecosistemas digitales.</em>
    </h1>
    <p class="entrada">
      Diseñamos, construimos y conectamos productos digitales que transforman ideas en soluciones
      reales.
    </p>
  </div>

  <p class="descenso" aria-hidden="true">
    <span class="arista"></span>
    <span class="texto">Desliza</span>
  </p>
</section>

<style>
  .vacio {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  /* En pantallas apaisadas estrechas (tablet, móvil horizontal) el texto no
     pisa la gota: su borde izquierdo cae hacia el 52 % del ancho (centro al
     70 % menos su radio). Detrás de un texto la escena baja sus brillos. */
  .contenido {
    display: grid;
    gap: 1.75rem;
    max-width: min(40rem, 46vw);
  }

  .contenido > * {
    margin: 0;
  }

  h1 {
    font-size: var(--t-5);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 11ch;
  }

  .entrada {
    max-width: 40ch;
    font-size: var(--t-1);
    color: var(--texto-suave);
  }

  /* Invitación a bajar: una arista vertical por la que desciende una luz. */
  .descenso {
    position: absolute;
    right: max(var(--margen), (100% - var(--ancho)) / 2);
    bottom: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin: 0;
  }

  .descenso .texto {
    font-size: var(--t--2);
    letter-spacing: var(--rastreo-rotulo);
    text-transform: uppercase;
    color: var(--metadato);
    writing-mode: vertical-rl;
  }

  .arista {
    position: relative;
    width: 1px;
    height: 4.5rem;
    overflow: hidden;
    background: var(--linea-fuerte);
  }

  .arista::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--cian), transparent);
    translate: 0 -100%;
  }

  /* Entrada desde la sombra: el texto sube y se aclara, escalonado. */
  :global(.movimiento) .contenido > * {
    animation: emerger 1.1s var(--suave) both;
  }

  :global(.movimiento) .rotulo {
    animation-delay: 0.15s;
  }

  :global(.movimiento) h1 {
    animation-delay: 0.25s;
  }

  :global(.movimiento) .entrada {
    animation-delay: 0.5s;
  }

  :global(.movimiento) .descenso {
    animation: emerger 1.1s var(--suave) 0.9s both;
  }

  :global(.movimiento) .arista::after {
    animation: descender 2.6s cubic-bezier(0.6, 0, 0.4, 1) 1.4s infinite;
  }

  @keyframes emerger {
    from {
      opacity: 0;
      translate: 0 1.2rem;
      filter: brightness(0.4);
    }
  }

  @keyframes descender {
    to {
      translate: 0 260%;
    }
  }

  /* Móvil o vertical: la escultura ocupa la mitad de arriba y el texto va debajo. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .vacio {
      align-content: end;
      padding-top: 50svh;
      padding-bottom: 5rem;
    }

    /* Aquí la gota va arriba y el texto debajo: todo el ancho. */
    .contenido {
      gap: 1.25rem;
      max-width: 40rem;
    }

    .descenso {
      display: none;
    }
  }
</style>
