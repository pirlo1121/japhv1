---
/**
 * Portada: The Digital Monolith × Liquid Technology. Un recorrido en nueve
 * escenas por una estructura digital monumental: monolitos de grafito que
 * se abren, se ordenan y revelan su interior, y una gota de cromo líquido
 * que se estira en una cinta y la recorre. Misterio → descubrimiento →
 * transformación → estructura → conexión → creación → resolución. El orden
 * de este archivo es el orden de la historia; cada escena es una <section>
 * con id propio, y scripts/historia/escenarios.ts dice dónde están la
 * cámara y la arquitectura en cada una (scripts/lienzo/arquitectura.ts).
 *
 *   01 El vacío             Vacio           plano general: el monolito y la gota
 *   02 La transformación    Transformacion  el monolito se abre en pórtico; la gota se estira en cinta
 *   03 La red viva          RedViva         el espacio se ensancha; la red crece desde la cinta
 *   04 El núcleo            Nucleo          la cámara avanza hacia la cámara interior
 *   05 Servicios            Servicios       siete módulos; se enciende el del servicio activo
 *   06 El proceso           Proceso         cuatro puertas; se enciende la de la fase actual
 *   07 Proyectos            Proyectos       una galería de nichos; la red se ordena
 *   08 Ecosistema           Ecosistema      plano amplio: todo alineado y conectado
 *   09 Hagámoslo real       Llamada         un último pórtico; la escultura en calma
 */
import Ecosistema from '@/components/portada/Ecosistema.astro';
import Lienzo from '@/components/portada/Lienzo.astro';
import Llamada from '@/components/portada/Llamada.astro';
import Nucleo from '@/components/portada/Nucleo.astro';
import Proceso from '@/components/portada/Proceso.astro';
import Proyectos from '@/components/portada/Proyectos.astro';
import Recorrido from '@/components/portada/Recorrido.astro';
import RedViva from '@/components/portada/RedViva.astro';
import Servicios from '@/components/portada/Servicios.astro';
import Transformacion from '@/components/portada/Transformacion.astro';
import Vacio from '@/components/portada/Vacio.astro';
import Base from '@/layouts/Base.astro';
import { sitio } from '@/config/sitio';

const escenas = [
  { id: 'inicio', nombre: 'Inicio' },
  { id: 'transformacion', nombre: 'Transformación' },
  { id: 'red', nombre: 'Red viva' },
  { id: 'nucleo', nombre: 'Núcleo' },
  { id: 'servicios', nombre: 'Servicios' },
  { id: 'proceso', nombre: 'Proceso' },
  { id: 'proyectos-destacados', nombre: 'Proyectos' },
  { id: 'ecosistema', nombre: 'Ecosistema' },
  { id: 'llamada', nombre: 'Contacto' }
];
---

<Base titulo={`${sitio.nombre} · ${sitio.lema}`} descripcion={sitio.descripcion} inmersiva>
  <Lienzo />
  <Vacio />
  <Recorrido escenas={escenas} />
  <Transformacion />
  <RedViva />
  <Nucleo />
  <Servicios />
  <Proceso />
  <Proyectos />
  <Ecosistema />
  <Llamada />
</Base>

<script>
  import { iniciarHistoria } from '@/scripts/historia/iniciar';
  import { iniciarLienzo } from '@/scripts/lienzo/escena';
  import { crearEstadoNarrativo } from '@/scripts/lienzo/narrativa';

  const estado = crearEstadoNarrativo();
  iniciarHistoria(estado);
  // Solo en desarrollo: inspeccionar y ajustar la escena desde la consola.
  if (import.meta.env.DEV) Object.assign(window, { __estado: estado });

  // Los nombres de las ramas de la red son los de los servicios, tal como están en la página.
  const ramas = [...document.querySelectorAll('[data-rama] h3')].map((h) => h.textContent ?? '');
  // La escultura compila su shader después de la primera pintura del texto.
  const arrancar = () => {
    const escena = iniciarLienzo(estado, ramas);
    if (import.meta.env.DEV) Object.assign(window, { __escena: escena });
  };
  if ('requestIdleCallback' in window) requestIdleCallback(arrancar, { timeout: 600 });
  else setTimeout(arrancar, 200);
</script>
