---
/**
 * Escena 07 · Proyectos. El guía, junto al titular, presenta cada
 * proyecto según pasa por el centro; la red se ordena y la escena se calla
 * para que hablen los proyectos. Cada uno dice qué se creó, qué problema resolvía, qué hizo
 * JAPH y, solo si está verificado, qué resultado tuvo.
 *
 * Los casos vienen de datos/proyectos.ts. Mientras sean ejemplos se marcan
 * como tales: nunca se presentan como trabajo real.
 */
import { Image } from 'astro:assets';
import NotaEjemplo from '@/components/ui/NotaEjemplo.astro';
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import { destacados } from '@/datos/proyectos';

const hayEjemplos = destacados.some((proyecto) => proyecto.ejemplo);
const dos = (n: number) => String(n).padStart(2, '0');
---

<section
  class="proyectos"
  id="proyectos-destacados"
  aria-labelledby="titulo-destacados"
  data-escena="Proyectos"
>
  <header class="cabecera" data-revelar data-zona-lectura>
    <p class="rotulo">07 · Proyectos</p>
    <h2 id="titulo-destacados" data-gota>
      Proyectos que <em>cobran vida.</em>
    </h2>
    {hayEjemplos && (
      <NotaEjemplo titulo="Contenido de ejemplo.">
        Los tres casos de esta sección son marcadores de posición. Sustituye nombres, textos e
        imágenes por proyectos reales de JAPH (src/datos/proyectos.ts) antes de publicar el sitio.
      </NotaEjemplo>
    )}
  </header>

  <ol class="lista">
    {destacados.map((proyecto, i) => (
      <li class="proyecto" data-guia>
        <article aria-labelledby={`proyecto-${i}`} data-liquido>
          <div class="visual" data-reflejo>
            {proyecto.imagen ? (
              <Image
                class="medio"
                src={proyecto.imagen}
                alt={proyecto.alt ?? ''}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 26rem, (min-width: 40rem) 50vw, 100vw"
              />
            ) : (
              <div class:list={['medio', 'pintura', `tono-${proyecto.tono}`]} aria-hidden="true" />
            )}
            <span class="ordinal" aria-hidden="true">
              {dos(i + 1)}
            </span>
          </div>
          <div class="texto">
            <h3 id={`proyecto-${i}`}>{proyecto.titulo}</h3>
            <p class="descripcion">{proyecto.descripcion}</p>
            <dl>
              <div>
                <dt>Problema</dt>
                <dd>{proyecto.problema}</dd>
              </div>
              <div>
                <dt>Rol de JAPH</dt>
                <dd>{proyecto.rol}</dd>
              </div>
              {proyecto.resultado && (
                <div>
                  <dt>Resultado</dt>
                  <dd>{proyecto.resultado}</dd>
                </div>
              )}
            </dl>
            <p class="pie">
              {proyecto.enlace && (
                <a href={proyecto.enlace}>
                  Ver proyecto <span class="solo-lectores">{proyecto.titulo}</span>
                  <span aria-hidden="true">→</span>
                </a>
              )}
              {proyecto.ejemplo && <SelloEjemplo>Caso de ejemplo</SelloEjemplo>}
            </p>
          </div>
        </article>
      </li>
    ))}
  </ol>

  <p class="mas" data-revelar>
    <a class="boton" href="/proyectos">
      Ver todos los proyectos
    </a>
  </p>
</section>

<style>
  .cabecera {
    max-width: 40rem;
  }

  .lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    position: relative;
    display: grid;
    height: 100%;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    background: rgb(var(--superficie-rgb) / 0.9);
    transition:
      border-color 0.35s var(--suave),
      box-shadow 0.35s var(--suave);
  }

  /* Al pasar o enfocar: solo el borde superior recoge luz de la red. */
  article::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 1px;
    background: var(--degradado-red);
    opacity: 0;
    transition: opacity 0.35s var(--suave);
  }

  article:hover,
  article:focus-within {
    border-color: rgb(var(--cian-rgb) / 0.22);
    box-shadow: 0 18px 40px -24px rgb(var(--azul-rgb) / 0.55);
  }

  article:hover::before,
  article:focus-within::before {
    opacity: 1;
  }

  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .medio {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual .ordinal {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
  }

  .texto {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .texto > * {
    margin: 0;
  }

  h3 {
    font-size: var(--t-2);
  }

  dl {
    gap: 0.6rem;
    margin: 0.25rem 0 0;
    font-size: var(--t--1);
  }

  dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--metadato);
  }

  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .pie a {
    color: var(--texto);
    text-decoration: none;
  }

  .pie a span[aria-hidden] {
    color: var(--verde);
  }

  .mas {
    margin: 2.5rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    article,
    article::before {
      transition: none;
    }
  }
</style>
