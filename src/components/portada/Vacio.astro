---
/**
 * Escena 01 · El vacío. Una gota de metal líquido flota en un espacio azul
 * medianoche, a la derecha del titular (en móvil, encima). Al bajar a la
 * segunda escena toma forma de guía: un robot líquido. Unos pocos
 * filamentos duermen al fondo. Los hilos de seda (Seda.astro) tejen el
 * titular al cargar; la entradilla y la invitación a bajar entran justo
 * detrás, escalonadas (solo con movimiento). Una gota que cae por un
 * filamento invita a bajar.
 */
---

<section class="vacio" id="inicio" aria-labelledby="titulo-vacio" data-escena="Inicio">
  <div class="contenido" data-zona-lectura>
    <p class="rotulo">Estrategia / Diseño / Tecnología</p>
    <h1 id="titulo-vacio" data-guia data-seda="texto" data-seda-inicio>
      Convertimos ideas en <em>ecosistemas digitales.</em>
    </h1>
    <p class="entrada">
      Diseñamos, construimos y conectamos productos digitales que transforman ideas en soluciones
      reales.
    </p>
  </div>

  <dl class="meta">
    <div class="descenso" aria-hidden="true">
      <dt>Recorrido</dt>
      <dd>
        <span class="hilo"></span>Desliza
      </dd>
    </div>
  </dl>
</section>

<style>
  .vacio {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .contenido {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .contenido > * {
    margin: 0;
  }

  h1 {
    font-size: var(--t-5);
    line-height: 0.96;
    max-width: 11ch;
  }

  .entrada {
    max-width: 44ch;
    font-size: var(--t-1);
    color: var(--texto-suave);
  }

  .meta {
    position: absolute;
    left: max(var(--margen), (100% - var(--ancho)) / 2);
    right: max(var(--margen), (100% - var(--ancho)) / 2);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin: 0;
    font-size: var(--t--1);
  }

  .meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--metadato);
  }

  .meta dd {
    color: var(--texto-suave);
  }

  .descenso {
    margin-left: auto;
    text-align: right;
  }

  /* Una gota de cromo que cae por un filamento y se desvanece al llegar abajo. */
  .hilo {
    position: relative;
    display: inline-block;
    width: 1px;
    height: 2.4rem;
    margin-right: 0.75rem;
    vertical-align: middle;
    background: linear-gradient(to bottom, transparent, rgb(var(--cian-rgb) / 0.5), transparent);
  }

  .hilo::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 7px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--gota);
    box-shadow: 0 0 8px rgb(var(--cian-rgb) / 0.6);
    translate: -50% 0;
    animation: caer 2.2s cubic-bezier(0.55, 0, 0.75, 0.4) infinite;
  }

  @keyframes caer {
    0% {
      top: -4px;
      opacity: 0;
      scale: 0.6;
    }
    15% {
      opacity: 1;
      scale: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 3px);
      opacity: 0;
      scale: 1 0.6;
    }
  }

  /* Entrada escalonada, justo detrás del titular (solo con movimiento). */
  :global(.movimiento) .entrada,
  :global(.movimiento) .meta {
    animation: aparecer 0.65s var(--suave) both;
  }

  :global(.movimiento) .entrada {
    animation-delay: 0.45s;
  }

  :global(.movimiento) .meta {
    animation-delay: 0.8s;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      translate: 0 0.9rem;
    }
  }

  /* Móvil o vertical: la escultura ocupa la mitad de arriba y el texto va debajo. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .vacio {
      align-content: end;
      padding-top: 48svh;
      padding-bottom: 6rem;
    }

    .meta {
      bottom: 1.25rem;
      gap: 0.5rem 1.5rem;
    }

    .descenso {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hilo::after {
      animation: none;
    }
  }
</style>
