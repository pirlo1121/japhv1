---
/**
 * Capítulo 03 · Capacidades. Aquí manda la claridad: qué hace JAPH, en una
 * lista editorial con los siete servicios reales (datos/servicios.ts), cada
 * uno con su nombre, su descripción y su enlace.
 *
 * Detrás, las piezas del pórtico se reordenan en una columnata de siete
 * losas, una por servicio. Al pasar el puntero, enfocarlo con el teclado o
 * cruzar el centro de la pantalla, el servicio se activa y su losa recoge
 * luz fría en las aristas (scripts/historia/servicios.ts). La escultura
 * queda a la derecha, atenuada: acompaña, no compite. En móvil la lista
 * empieza arriba y la escena queda quieta y apagada detrás.
 */
import IconoServicio from '@/components/ui/IconoServicio.astro';
import { servicios } from '@/datos/servicios';

const dos = (n: number) => String(n).padStart(2, '0');
---

<section
  class="servicios"
  id="servicios"
  aria-labelledby="titulo-servicios"
  data-servicios
  data-escena="Servicios"
>
  <header class="cabecera" data-revelar data-zona-lectura>
    <p class="rotulo">03 · Servicios</p>
    <h2 id="titulo-servicios">
      Tecnología que conecta <em>las piezas.</em>
    </h2>
    <p>
      Conectamos productos, datos y procesos para crear sistemas que trabajan juntos. Siete
      capacidades que funcionan por separado y rinden más juntas.
    </p>
  </header>

  <ol class="lista" data-zona-lectura>
    {servicios.map((servicio, i) => (
      <li class="servicio" id={`servicio-${servicio.id}`} data-servicio>
        <span class="icono">
          <IconoServicio id={servicio.id} />
        </span>
        <span class="ordinal" aria-hidden="true">
          {dos(i + 1)}
        </span>
        <h3>{servicio.nombre}</h3>
        <p>{servicio.resumen}</p>
        <a href={`/servicios#${servicio.id}`}>
          Qué incluye <span class="solo-lectores">{servicio.nombre}</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .servicios {
    display: grid;
    gap: 1rem;
  }

  /* La columnata ocupa la derecha: la lista no pasa del 58 % del ancho. */
  .cabecera,
  .lista {
    max-width: min(40rem, 58vw);
  }

  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linea);
  }

  .servicio {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 2rem 1fr auto;
    grid-template-areas:
      'icono ordinal nombre enlace'
      'icono ordinal texto texto';
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    align-items: baseline;
    padding: 1.15rem 0.9rem;
    border-bottom: 1px solid var(--linea);
    background: rgb(var(--vacio-rgb) / 0.6);
    transition:
      background-color var(--rapido),
      border-color var(--rapido);
  }

  /* El filamento que se enciende en el borde del servicio activo. */
  .servicio::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: linear-gradient(180deg, var(--metal-luz), var(--frio));
    opacity: 0;
    transition: opacity var(--rapido);
  }

  .servicio[data-activa] {
    background: linear-gradient(
      90deg,
      rgb(var(--grafito-rgb) / 0.5),
      rgb(var(--monolito-rgb) / 0.85)
    );
  }

  .servicio[data-activa]::before {
    opacity: 1;
  }

  .icono {
    grid-area: icono;
    align-self: center;
    display: grid;
    place-items: center;
    width: 2.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: rgb(var(--monolito-rgb) / 0.8);
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.1);
    color: var(--metadato);
    transition:
      color var(--rapido),
      border-color var(--rapido);
  }

  .servicio[data-activa] .icono {
    border-color: rgb(var(--metal-rgb) / 0.5);
    color: var(--metal-luz);
  }

  .ordinal {
    grid-area: ordinal;
  }

  h3 {
    grid-area: nombre;
    font-size: var(--t-1);
    letter-spacing: -0.01em;
  }

  .servicio p {
    grid-area: texto;
    margin: 0;
    font-size: var(--t--1);
  }

  .servicio a {
    grid-area: enlace;
    font-size: var(--t--1);
    color: var(--texto-suave);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--rapido);
  }

  .servicio a:hover,
  .servicio[data-activa] a {
    color: var(--texto);
  }

  .servicio[data-activa] a span[aria-hidden] {
    color: var(--frio);
  }

  /* Todo el servicio es clicable sin anidar enlaces: el enlace se estira. */
  .servicio a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .servicio a:focus-visible {
    outline: none;
  }

  .servicio:has(a:focus-visible) {
    outline: 2px solid var(--frio);
    outline-offset: -2px;
  }

  /* Móvil o vertical: la escena queda detrás, quieta y apagada: todo el ancho. */
  @media (max-aspect-ratio: 85/100), (max-width: 47.99rem) {
    .cabecera,
    .lista {
      max-width: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .servicio {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'icono nombre'
        'icono texto'
        'icono enlace';
    }

    .ordinal {
      display: none;
    }

    .servicio a {
      margin-top: 0.35rem;
    }
  }
</style>
