---
/** Preguntas desplegables con <details>/<summary>: accesibles y sin JavaScript. */
import type { Pregunta } from '@/datos/preguntas';

interface Props {
  preguntas: Pregunta[];
}

const { preguntas } = Astro.props;
---

<div class="acordeon">
  {preguntas.map(({ pregunta, respuesta }) => (
    <details class="item">
      <summary>
        <span>{pregunta}</span>
        <span class="signo" aria-hidden="true" />
      </summary>
      <p>{respuesta}</p>
    </details>
  ))}
</div>

<style>
  .acordeon {
    border-top: 1px solid var(--linea);
  }

  .item {
    border-bottom: 1px solid var(--linea);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    padding: 1.4rem 0;
    font-family: var(--fuente-display);
    font-size: var(--t-2);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--metadato);
  }

  .signo {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }

  .signo::before,
  .signo::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--metadato);
    transition: rotate var(--rapido);
  }

  .signo::after {
    rotate: 90deg;
  }

  .item[open] .signo::after {
    rotate: 0deg;
  }

  p {
    max-width: 62ch;
    margin: 0 0 1.5rem;
    color: var(--texto-suave);
  }
</style>
