---
/**
 * Lienzo.astro
 * La escena compartida de toda la portada, fija detrás de la historia: la
 * arquitectura de monolitos y la escultura de cromo líquido (WebGL2,
 * scripts/lienzo), y, encima, la red viva (Canvas 2D) proyectada con la
 * misma cámara. La arranca pages/index.astro.
 *
 * La gota se ve real desde el primer instante: mientras WebGL compila (o
 * si no puede, o sin JavaScript) se ve su póster, el primer fotograma del
 * mismo sombreador (assets/gota-inicial.webp), en el sitio y al tamaño
 * exactos en que lo pintará WebGL, sobre un fondo que reproduce el del
 * sombreador. WebGL arranca en ese mismo fotograma (con la arquitectura
 * aún en la oscuridad, de la que emerge después), así que el relevo no se
 * nota. La posición sale de la misma cuenta que la cámara (camara.ts):
 * el centro de la gota cae en el desplazamiento del escenario inicial y una
 * unidad del mundo mide FOCAL / distancia · alto / 2 (o, en pantallas más
 * estrechas que ASPECTO_MINIMO, · ancho / 2 / ASPECTO_MINIMO). Sin WebGL la
 * escena mueve el póster a donde iría la escultura (--x, --y, --s).
 */
import { Picture } from 'astro:assets';
import gotaInicial from '@/assets/gota-inicial.webp';
import { ALTO_VERTICAL } from '@/scripts/historia/escenarios';
import { ASPECTO_MINIMO, FOCAL } from '@/scripts/lienzo/camara';
import { ESCENARIO_INICIAL, POSTER_DE_LA_GOTA } from '@/scripts/lienzo/narrativa';

const { distancia, desplazamientoX, desplazamientoY } = ESCENARIO_INICIAL;
const camara = {
  // Px por unidad del mundo, como fracción de medio alto (o medio ancho en vertical).
  escalaAncha: FOCAL / distancia,
  escalaEstrecha: FOCAL / (distancia * ASPECTO_MINIMO),
  dx: desplazamientoX,
  dy: desplazamientoY,
  dyVertical: Math.max(desplazamientoY, ALTO_VERTICAL),
  lado: POSTER_DE_LA_GOTA.extension * 2
};
---

<div class="lienzo" data-lienzo>
  <div class="respaldo" data-respaldo aria-hidden="true">
    <Picture
      src={gotaInicial}
      formats={['avif', 'webp']}
      widths={[480, 760, 1100, 1500]}
      sizes="(max-aspect-ratio: 85/100) 103vw, 88vh"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <canvas class="escultura" data-escultura aria-hidden="true"></canvas>
  <canvas class="red" data-red aria-hidden="true"></canvas>
</div>

<style define:vars={camara}>
  /* Alto "lvh": no cambia cuando la barra del navegador móvil aparece o se esconde. */
  .lienzo {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100lvh;
    z-index: -1;
    overflow: hidden;
    background: var(--fondo);
    pointer-events: none;
    /* Las medidas del póster son fracciones del propio lienzo (cqw, cqh). */
    container-type: size;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .escultura {
    opacity: 0;
    transition: opacity 0.6s var(--suave);
  }

  .lienzo[data-listo] .escultura {
    opacity: 1;
  }

  .lienzo[data-listo] .respaldo {
    opacity: 0;
    transition: opacity 0.6s var(--suave) 0.6s;
  }

  /*
   * Póster y fondo de la escena hasta que WebGL pinta. --x, --y: centro de
   * la gota; --s: px por unidad del mundo. El fondo es el del sombreador
   * (main en sombreador.ts): un halo azul gaussiano centrado en la gota,
   * exp(-0.9·r²) con r en medios altos, y un resto violeta lejano.
   */
  .respaldo {
    --x: calc((1 + var(--dx)) * 50%);
    --y: calc((1 - var(--dy)) * 50%);
    --s: calc(var(--escalaAncha) * 50cqh);
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at calc(var(--x) - 60cqh) calc(var(--y) + 45cqh),
        rgb(var(--violeta-escena-rgb) / 1) 0,
        rgb(var(--violeta-escena-rgb) / 0.86) 25cqh,
        rgb(var(--violeta-escena-rgb) / 0.55) 50cqh,
        rgb(var(--violeta-escena-rgb) / 0.26) 75cqh,
        rgb(var(--violeta-escena-rgb) / 0.09) 100cqh,
        transparent 150cqh
      ),
      radial-gradient(
        circle at var(--x) var(--y),
        rgb(var(--halo-escena-rgb) / 1) 0,
        rgb(var(--halo-escena-rgb) / 0.945) 12.5cqh,
        rgb(var(--halo-escena-rgb) / 0.8) 25cqh,
        rgb(var(--halo-escena-rgb) / 0.6) 37.5cqh,
        rgb(var(--halo-escena-rgb) / 0.41) 50cqh,
        rgb(var(--halo-escena-rgb) / 0.245) 62.5cqh,
        rgb(var(--halo-escena-rgb) / 0.13) 75cqh,
        rgb(var(--halo-escena-rgb) / 0.064) 87.5cqh,
        rgb(var(--halo-escena-rgb) / 0.027) 100cqh,
        transparent 125cqh
      ),
      var(--fondo);
  }

  /* Más estrecho que ASPECTO_MINIMO: el campo de visión se abre y la escala sigue al ancho. */
  @container (max-aspect-ratio: 85/100) {
    .respaldo {
      --s: calc(var(--escalaEstrecha) * 50cqw);
    }
  }

  /* Pantallas verticales o estrechas (ASPECTO_VERTICAL en iniciar.ts): la gota arriba y centrada. */
  @container (max-aspect-ratio: 85/100) or (max-width: 47.99rem) {
    .respaldo {
      --x: 50%;
      --y: calc((1 - var(--dyVertical)) * 50%);
    }
  }

  /* El póster, con el borde fundido en el fondo. */
  .respaldo :global(img) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * var(--lado));
    /* En móvil el póster es algo más ancho que la pantalla: no se recorta. */
    max-width: none;
    height: auto;
    aspect-ratio: 1;
    translate: -50% -50%;
    mask-image: radial-gradient(closest-side, rgb(0 0 0) 78%, transparent);
    opacity: calc(1 - var(--apagado, 0) * 0.75);
  }

  /* Al recargar a media página la escena ya no es la gota: no se muestra su póster. */
  .respaldo[data-oculto] :global(img) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .escultura,
    .lienzo[data-listo] .respaldo {
      transition: none;
    }
  }
</style>
