---
/**
 * Capítulo 04 · Método. Las cuatro fases reales de trabajo
 * (datos/proceso.ts) son cuatro puertas en un camino: detrás, la
 * arquitectura levanta cuatro marcos que se adentran en el espacio, la
 * curva de cromo (el proyecto) los cruza en orden y se enciende el de la
 * fase actual; aquí, un camino de luz pasa por cuatro umbrales.
 *
 * Con movimiento en escritorio las fases van en fila sobre el camino, que
 * se ilumina hasta la fase actual mientras el capítulo sube por la
 * pantalla (scripts/historia/proceso.ts). En móvil es una lista vertical
 * con una arista que se llena. Las fases son HTML: el dibujo solo acompaña.
 *
 * Debajo, los principios de trabajo reales de JAPH (datos/nosotros.ts): lo
 * que no cambia de una fase a otra.
 */
import { principios } from '@/datos/nosotros';
import { fases } from '@/datos/proceso';

const dos = (n: number) => String(n).padStart(2, '0');
/** Centros de los nodos en el dibujo (viewBox 1000 × 200): uno sobre cada columna. */
const nodos = fases.map((_, i) => ({
  x: ((i + 0.5) / fases.length) * 1000,
  y: i % 2 === 0 ? 132 : 72
}));
// Una curva suave que pasa por todos los nodos (tangentes horizontales).
const camino = nodos
  .map((n, i) => {
    if (i === 0) return `M${n.x} ${n.y}`;
    const a = nodos[i - 1]!;
    const medio = (a.x + n.x) / 2;
    return `C${medio} ${a.y} ${medio} ${n.y} ${n.x} ${n.y}`;
  })
  .join(' ');
/** En la portada basta la primera frase de cada principio. */
const primeraFrase = (texto: string) => texto.split(/(?<=\.)\s/)[0] ?? texto;
---

<section
  class="proceso"
  id="proceso"
  aria-labelledby="titulo-proceso"
  data-proceso
  data-escena="Proceso"
  style={{ '--fases': fases.length }}
>
  <div class="marco">
    <header class="cabecera" data-zona-lectura>
      <p class="rotulo">04 · Método</p>
      <h2 id="titulo-proceso">
        De la idea <em>al ecosistema.</em>
      </h2>
      <p>Un proceso claro para transformar objetivos en productos digitales sostenibles.</p>
      <p class="contador" aria-hidden="true">
        Fase <span data-proceso-actual>1</span> / {fases.length}
      </p>
    </header>

    <div class="dibujo" aria-hidden="true">
      <svg viewBox="0 0 1000 200" preserveAspectRatio="none">
        <defs>
          <linearGradient id="degradado-camino" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" style="stop-color: var(--metal)" />
            <stop offset="1" style="stop-color: var(--frio)" />
          </linearGradient>
        </defs>
        <path class="base" d={camino} />
        <path class="luz" d={camino} pathLength="1" />
      </svg>
      {nodos.map((n, i) => (
        <span
          class="punto"
          data-punto={i}
          style={{ left: `${n.x / 10}%`, top: `${(n.y / 200) * 100}%`, '--i': i }}
        />
      ))}
    </div>

    <ol class="fases" data-zona-lectura>
      {fases.map(({ titulo, descripcion }, i) => (
        <li class="fase" data-fase>
          <span class="nodo" aria-hidden="true" />
          <p class="numero">{dos(i + 1)}</p>
          <h3>{titulo}</h3>
          <p class="descripcion">{descripcion}</p>
        </li>
      ))}
    </ol>

    <div class="principios" data-revelar data-zona-lectura>
      <h3 class="titulo-principios">Lo que no cambia en ninguna fase</h3>
      <ul aria-label="Principios de trabajo">
        {principios.map(({ titulo, descripcion }) => (
          <li>
            <h4>{titulo}</h4>
            <p>{primeraFrase(descripcion)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .marco {
    display: grid;
    gap: 1.5rem;
  }

  .cabecera {
    max-width: 40rem;
    margin-bottom: 0;
  }

  .contador {
    display: none;
    font-size: var(--t--1);
    font-variant-numeric: tabular-nums;
    color: var(--metadato);
  }

  .fases {
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  /* Móvil y sin movimiento: un filamento vertical que se llena con --avance. */
  .fases::before,
  .fases::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.5rem;
    width: 1px;
    bottom: 0.5rem;
    background: var(--linea-fuerte);
  }

  .fases::after {
    bottom: auto;
    height: calc((100% - 1rem) * var(--avance, 1));
    background: linear-gradient(to bottom, var(--metal), var(--frio));
  }

  .fase {
    position: relative;
    display: grid;
    gap: 0.4rem;
    transition: opacity 0.4s var(--suave);
  }

  .fase .nodo {
    position: absolute;
    left: calc(-1.75rem + 1px);
    top: 0.35rem;
    width: 7px;
    aspect-ratio: 1;
    border-radius: 1px;
    background: var(--metal);
    transition:
      background-color 0.4s var(--suave),
      box-shadow 0.4s var(--suave),
      scale 0.4s var(--suave);
  }

  .numero {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--metadato);
  }

  h3 {
    font-size: var(--t-2);
  }

  .descripcion {
    margin: 0;
    max-width: 36ch;
  }

  .dibujo {
    display: none;
  }

  /* Con movimiento: la fase actual brilla, las anteriores quedan a medias. */
  .en-escena .fase {
    opacity: 0.45;
  }

  .en-escena .fase.alcanzada {
    opacity: 0.75;
  }

  .en-escena .fase.activa {
    opacity: 1;
  }

  .en-escena .fase.activa .nodo {
    background: var(--frio);
    scale: 1.4;
  }

  .en-escena .contador {
    display: block;
  }

  /* ---------------------------------------------------------- en fila (escritorio) */

  .horizontal .marco {
    gap: 0;
  }

  .horizontal .dibujo {
    position: relative;
    display: block;
    height: clamp(7rem, 18vh, 10rem);
    margin: 1.5rem 0 1rem;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  svg path {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .base {
    stroke: var(--linea-fuerte);
    stroke-width: 1;
  }

  .luz {
    stroke: url(#degradado-camino);
    stroke-width: 2;
    stroke-dasharray: 1;
    /* La luz llega a la fase actual: avance × fases / tramos entre fases. */
    stroke-dashoffset: calc(1 - min(1, var(--avance, 0) * var(--fases) / (var(--fases) - 1)));
  }

  /* Cada fase es un umbral: un marco mínimo, como las puertas de la escena. */
  .punto {
    position: absolute;
    width: 14px;
    height: 20px;
    border: 1px solid rgb(var(--metal-rgb) / 0.7);
    border-radius: 1px;
    background: var(--fondo);
    box-shadow: inset 0 1px 0 rgb(var(--metal-rgb) / 0.3);
    translate: -50% -50%;
  }

  /* El umbral se enciende cuando la luz lo alcanza. */
  .punto::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 0;
    background: linear-gradient(180deg, var(--metal-luz), var(--frio));
    opacity: clamp(0, (var(--avance, 0) * var(--fases) - var(--i)) * 8, 1);
  }

  .horizontal .fases {
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding: 0;
  }

  .horizontal .fases::before,
  .horizontal .fases::after,
  .horizontal .fase .nodo {
    display: none;
  }

  .horizontal .fase {
    justify-items: center;
    text-align: center;
  }

  .horizontal h3 {
    font-size: var(--t-1);
  }

  .horizontal .descripcion {
    font-size: var(--t--1);
  }

  /* Los principios: una placa de cuatro celdas separadas por aristas. */
  .principios {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 8vh, 5rem);
  }

  .titulo-principios {
    font-size: var(--t-1);
    letter-spacing: -0.01em;
    color: var(--texto-suave);
  }

  .principios ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--linea);
  }

  .principios li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.2rem 1.25rem 1.3rem;
    background: rgb(var(--monolito-rgb) / 0.94);
  }

  h4 {
    margin: 0;
    font-size: var(--t-0);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .principios li p {
    margin: 0;
    font-size: var(--t--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .fase,
    .fase .nodo {
      transition: none;
    }
  }
</style>
